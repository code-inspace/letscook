# ==========================================
# LET'S COOK - ENV CONFIGURATION TEMPLATE
# ==========================================

# 1. Supabase Configuration (Nouveau projet Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Application Envelope Encryption Key (AES-256-GCM)
# Clé secrète utilisée pour chiffrer les titres, étapes et ingrédients dans Supabase
NEXT_PUBLIC_ENCRYPTION_KEY=your_secret_encryption_master_key_phrase_2026

# 3. AI Multimodal Vision (Au moins une des deux clés requise pour l'import de fiches recettes)
# Google Gemini 2.5 Flash (Recommandé pour sa rapidité et précision sur documents multi-photos)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative : OpenAI GPT-4o Vision
OPENAI_API_KEY=your_openai_api_key_here
